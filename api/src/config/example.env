# ===== General configuration =====
DEBUG=False

# ===== Database configuration =====
DB_URI=postgresql://postgres:yourpassword@host:port/yourdatabase

# ===== JWT configuration =====
JWT_ACCESS_SECRET_KEY=anyrandomstringforaccesskey
JWT_REFRESH_SECRET_KEY=anyrandomstringforrefreshkey
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ===== Google OAuth2 configuration =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== CORS configuration =====
CORS_ORIGINS=https://example.com, http://anotherdomain.com
